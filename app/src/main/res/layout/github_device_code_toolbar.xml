<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#172231"
    android:paddingLeft="9dp"
    android:paddingRight="9dp">
    <TextView
        android:id="@+id/github_device_code_label"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:contentDescription="Одноразовый код GitHub" />
    <TextView
        android:id="@+id/github_device_copy"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:text="Копировать"
        android:textColor="#A8E6D0"
        android:textSize="12sp"
        android:contentDescription="Скопировать все восемь символов" />
    <TextView
        android:id="@+id/github_device_fill"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingLeft="10dp"
        android:paddingRight="8dp"
        android:text="Авто"
        android:textColor="#A8E6D0"
        android:textSize="12sp"
        android:contentDescription="Однократное автозаполнение восьми полей GitHub" />
</LinearLayout>
